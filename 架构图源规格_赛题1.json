  "cards": [
    {
      "dot": "cyan",
      "title": "① 具体工作流：把一次学习办完",
      "items": [
        "采集：语音 / 图像 / 手写 / 课件导入；语音转文字 + 确认",
        "理解：结构化笔记，低置信度标黄，可检查可修正",
        "积累：按 6 标签（课程·章节·知识点·难度·来源·版本）入资料库",
        "复用：RAG 溯源问答 → 苏格拉底四步 → 知识漏洞卡",
        "反馈：错题本 + 掌握度 → 期末复习出题 → 学习计划表"
      ]
    },
    {
      "dot": "emerald",
      "title": "② 怎么实现（单一事实来源）",
      "items": [
        "adapters.js 是唯一边界：5 个 Mock（ASR / OCR / LLM / RAG / Handoff）",
        "保持入参 / 返回形状不变，换真实实现时 B 的界面不改",
        "三核心数据对象：知识点 / 题目 / 错题·掌握度记录",
        "W3 技术 Spike：A 定端侧 vs 云端 ASR / OCR",
        "P0 交步1–3 可演示闭环；步4–8 交完整方案"
      ]
    },
    {
      "dot": "violet",
      "title": "③ 出题机制（待商量 · W8 前定案）",
      "items": [
        "用户设置 → 必出白名单 / 排除黑名单优先于权重",
        "用户不设置 → 权重兜底 0.4/0.2/0.2/0.15/0.05（草案，勿改）",
        "依据补充：单知识点表现 + 知识点串通（前置 / 关联）表现",
        "群体询问次数只做匿名聚合热度，不压过本人；出题可解释"
      ]
    },
    {
      "dot": "rose",
      "title": "④ 隐私边界怎么保护",
      "items": [
        "学生数据层在域内：掌握度 / 错题 / 提问 / 作业记录一律不外发",
        "AI 联网搜索只带课程目标，结果标来源，不发学生隐私",
        "询问次数 → 匿名聚合难点热度，不识别个体",
        "跨设备接力须用户确认；语音转文字须确认",
        "结论强制溯源 + 低置信度标黄防幻觉；D 模式防抄答案"
      ]
    },
    {
      "dot": "amber",
      "title": "⑤ 阶段与后置（保护 01.15）",
      "items": [
        "P0 初赛 W1–W7：步1–3 可演示闭环 + 完整方案",
        "P1 区域赛 W8–W12：步4–5 + OPPO 上架 + 20+ 人真实验证",
        "P2/P3 全国赛：步7 学习计划表",
        "最后添加的待办：语音问答 / 视频切片 / 关联课程"
      ]
    }
  ]
